<div class="terminal">
	<div id="terminal-output" class="terminal-output" aria-live="polite"></div>
</div>

<script>
	import { mountTerminal } from '../scripts/terminal-core';

	const output = document.getElementById('terminal-output');
	const term = document.querySelector('.terminal');

	mountTerminal({
		root: term,
		output,
		boot: async ({ printBlock, createPrompt, sleep, reduceMotion, BANNER }) => {
			const pre = document.createElement('pre');
			pre.className = 'banner';
			output.appendChild(pre);
			const text = BANNER.join('\n');
			if (reduceMotion) {
				pre.textContent = text;
			} else {
				for (const ch of text) {
					pre.textContent += ch;
					await sleep(7);
				}
			}
			await sleep(reduceMotion ? 0 : 150);
			printBlock(`Welcome to <span class="c-green">Astro Blog</span> — type <span class="c-green">help</span> to get started.`, 'block');
			await sleep(reduceMotion ? 0 : 80);
			const wrap = createPrompt();
			wrap.querySelector('input').focus({ preventScroll: true });
		},
	});
</script>

<style>
	.terminal {
		view-transition-name: terminal;
		--term-bg: #000000;
		--term-fg: #ffffff;
		--term-green: #00ff00;
		--term-red: #ff0000;
		--term-yellow: #ffff00;
		--term-cyan: #00ffff;
		--term-dim: #6a6a6a;
		--term-border: #1f1f1f;
		min-height: 100vh;
		background: var(--term-bg);
		color: var(--term-fg);
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', 'Courier New', monospace;
		font-size: 15px;
		line-height: 1.6;
	}

	.terminal-output {
		padding: 16px 18px;
	}

	::selection {
		background: var(--term-green);
		color: #000;
	}

	@media (max-width: 720px) {
		.terminal {
			font-size: 13px;
		}
		.terminal-output {
			padding: 12px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.terminal {
			view-transition-name: none;
		}
	}
</style>
